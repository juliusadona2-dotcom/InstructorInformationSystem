<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Instructor Information System</title>
    <script>
        // Apply saved theme before first paint (prevents a flash of the wrong theme)
        (function () {
            var t = "light";
            try { t = localStorage.getItem("iis-theme") || "light"; } catch (e) { }
            document.documentElement.setAttribute("data-theme", t);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var isAuthenticated = User.Identity?.IsAuthenticated == true;
        var userName = User.Identity?.Name ?? string.Empty;
        var initial = userName.Length > 0 ? userName.Substring(0, 1).ToUpperInvariant() : "?";
        var body = RenderBody();
    }

    @if (isAuthenticated)
    {
        <div class="app-shell">
            <div class="sb-scrim" id="sidebarScrim"></div>

            <aside class="sidebar" id="sidebar" aria-label="Main navigation">
                <a class="sb-brand" asp-controller="Account" asp-action="Dashboard">
                    <span class="brand-badge">IIS</span>
                    <span class="sb-brand-text">Instructor<br />Information System</span>
                </a>

                <nav class="sb-nav">
                    <a class="sb-link @(currentController == "Account" ? "active" : "")" asp-controller="Account" asp-action="Dashboard">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="2" /><rect x="14" y="3" width="7" height="5" rx="2" /><rect x="14" y="12" width="7" height="9" rx="2" /><rect x="3" y="16" width="7" height="5" rx="2" /></svg>
                        <span>Dashboard</span>
                    </a>
                    <a class="sb-link @(currentController == "Instructor" && currentAction != "Create" ? "active" : "")" asp-controller="Instructor" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                        <span>Instructors</span>
                    </a>
                    <a class="sb-link @(currentController == "Instructor" && currentAction == "Create" ? "active" : "")" asp-controller="Instructor" asp-action="Create">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8v8M8 12h8" /></svg>
                        <span>Add instructor</span>
                    </a>
                </nav>

                <div class="sb-foot">
                    <button type="button" class="sb-link theme-toggle" id="themeToggle" aria-label="Switch to dark mode" title="Switch theme">
                        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                        <span class="theme-toggle-text">Dark mode</span>
                    </button>

                    <div class="sb-user">
                        <span class="user-avatar">@initial<span class="user-dot"></span></span>
                        <span class="sb-user-text"><strong>@userName</strong><small>Signed in</small></span>
                    </div>

                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="sb-link sb-logout">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>
                            <span>Log out</span>
                        </button>
                    </form>
                </div>
            </aside>

            <div class="app-main">
                <div class="topbar">
                    <button type="button" class="menu-btn" id="sidebarOpen" aria-label="Open menu">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                    </button>
                    <span class="brand-badge brand-badge-sm">IIS</span>
                    <strong>Instructor Information System</strong>
                </div>

                <main class="page-shell">
                    @body
                </main>

                <footer class="app-footer">&copy; @DateTime.Now.Year Instructor Information System</footer>
            </div>
        </div>
    }
    else
    {
        <header class="guest-bar">
            <a class="guest-brand" asp-controller="Account" asp-action="Login">
                <span class="brand-badge brand-badge-sm">IIS</span>
                <span>Instructor Information System</span>
            </a>
            <div class="guest-actions">
                <button type="button" class="btn-glass theme-toggle" id="themeToggle" aria-label="Switch to dark mode" title="Switch theme">
                    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                    <span class="theme-toggle-text">Dark mode</span>
                </button>
                <a class="btn-glass" asp-controller="Account" asp-action="Login">Login</a>
                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Create account</a>
            </div>
        </header>

        <main class="container page-shell">
            @body
        </main>

        <footer class="app-footer">&copy; @DateTime.Now.Year Instructor Information System</footer>
    }

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>